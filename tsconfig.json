{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "types": ["@league-of-foundry-developers/foundry-vtt-types"]
  },
  "include": ["scripts/**/*.js", "scripts/**/*.d.ts"]
}
